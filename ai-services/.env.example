# ─────────────────────────────────────────────────────────────
# Python AI services (FastAPI) — environment template (E0.3)
# These services are NEVER reachable from browsers/mobile; only the
# Spring backend calls them with the shared service token.
# Copy to `.env` inside the ai-services deployment (not in git).
# ─────────────────────────────────────────────────────────────
# Model/provider config
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Service auth: backend sends `X-Service-Token: <token>`; services reject otherwise
PYTHON_AI_SERVICE_TOKEN=
PYTHON_AI_SERVICE_PORT=8000
# Allowed caller (backend base URL / service mesh identity)
ALLOWED_CALLER=http://localhost:8080
LOG_LEVEL=INFO
