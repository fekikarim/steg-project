<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 (API 31) replaced the windowBackground splash with the
      platform SplashScreen API: the OS draws windowSplashScreenBackground plus
      windowSplashScreenAnimatedIcon and *ignores* the launch_background
      layer-list. Without these items the system falls back to the theme's
      colorBackground (white in light mode), which produced a white flash
      before the navy app splash. Declaring them keeps the cold start on-brand
      and continuous.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/steg_navy</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/steg_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
